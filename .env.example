# Copie para .env e ajuste. Nunca commitar o .env de verdade (ja esta no .gitignore).

# --- Postgres (docker-compose e apps/api) ---
POSTGRES_USER=adega
POSTGRES_PASSWORD=adega
POSTGRES_DB=adega
POSTGRES_PORT=5432

# String de conexao completa usada por apps/api e packages/db.
# Precisa bater com os valores POSTGRES_* acima quando rodando via docker-compose.
DATABASE_URL=postgres://adega:adega@localhost:5432/adega

# --- apps/api ---
PORT=3000
# String aleatoria longa (ex.: `openssl rand -hex 32`). Assina o cookie de
# sessao (src/seguranca/sessao.ts) -- trocar invalida todas as sessoes ativas.
SESSION_SECRET=troque-por-uma-string-aleatoria-longa-antes-de-rodar

# --- packages/db (seed de desenvolvimento) ---
# Trava explicita exigida por packages/db/src/seed-cli.ts: sem isso, `pnpm
# db:seed` se recusa a rodar mesmo com DATABASE_URL configurada.
ALLOW_DEV_SEED=true
