# Copie para .env e ajuste. Nunca commitar o .env de verdade (ja esta no .gitignore).

# --- Postgres (docker-compose e apps/api) ---
POSTGRES_USER=adega
POSTGRES_PASSWORD=adega
POSTGRES_DB=adega
POSTGRES_PORT=5432

# String de conexao completa usada por apps/api e packages/db.
# Precisa bater com os valores POSTGRES_* acima quando rodando via docker-compose.
DATABASE_URL=postgres://adega:adega@localhost:5432/adega

# --- apps/api ---
PORT=3000
